# Repo-wide line-ending policy.
#
# Default: let Git auto-detect text vs binary, but DO NOT force a working-tree
# EOL — that lets shell scripts on Linux/macOS keep LF and lets `.bat` keep
# CRLF, matching each platform's convention.
* text=auto

# --- Byte-sensitive files: pin LF on every platform. ---
#
# These are read with `include_str!` or `fs::read_to_string` and then
# byte-compared against in-memory data, so a Windows checkout that rewrote LF
# to CRLF would fail the assertion (or embed CRLF into a Rust binary). Pin LF
# explicitly so autocrlf can't touch them.
crates/session/tests/snapshots/*.json text eol=lf
crates/tools/tests/snapshots/*.json   text eol=lf
crates/tools/tests/fixtures/transcript_export/* text eol=lf
crates/ai/tests/snapshots/*.snap      text eol=lf
crates/ai/prompts/*.md                text eol=lf
# OpenAI's approved Sign in with ChatGPT logos: byte-identical to the
# official files, pinned by SHA-256 in tests, so never convert them.
apps/desktop/src/assets/chatgpt/*.svg -text
website/public/brand/openai/*.svg     -text

# The third-party notices are generated and compared byte for byte
# (scripts/third-party-notices/generate.mjs --check), and the installer check
# compares the bundled copy's SHA-256 with this file's: LF on every checkout.
apps/desktop/src-tauri/licenses/THIRD_PARTY_NOTICES.txt text eol=lf
scripts/third-party-notices/*.txt                       text eol=lf
scripts/third-party-notices/*.hbs                       text eol=lf
scripts/third-party-notices/*.toml                      text eol=lf

# --- Windows-specific scripts: keep CRLF. ---
*.bat text eol=crlf
*.cmd text eol=crlf

# --- Binaries: never line-end-convert. ---
*.wav  binary
*.mp3  binary
*.flac binary
*.onnx binary
*.bin  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.icns binary
*.dmg  binary
*.msi  binary

# --- The ONNX Runtime fetch script and its fixture. ---
#
# The script runs under bash on every CI runner, Windows included, where
# autocrlf would put a "\r" on every line and bash would stop at the first.
# The fixture is a binary protobuf, compared by what an ONNX Runtime does
# with its bytes, so no line-ending conversion may touch it.
scripts/fetch-ml-runtime.sh                 text eol=lf
crates/ml-pipeline/tests/fixtures/*.onnx    binary
