# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node
node_modules/
.pnpm-store/
dist/
dist-ssr/
.npm/

# Tauri
**/gen/schemas/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright (apps/desktop/e2e): generated audio fixtures and run output
apps/desktop/e2e/.generated/
apps/desktop/e2e/.dist/
apps/desktop/test-results/
apps/desktop/playwright-report/

# OS
.DS_Store
Thumbs.db

# Claude Code agent runtime state (isolated worktrees etc.) stays local.
# `settings.json` is the exception: it is the shared project config —
# which plugins the repo enables, and the marketplace they come from —
# and Claude Code's own convention is to commit it, while
# `settings.local.json` stays personal. `.claude/*` rather than `.claude/`
# because git cannot re-include a file inside a directory it ignores.
.claude/*
!.claude/settings.json

# Graphify tool output (local-only knowledge-graph cache)
.graphify_python
.graphify_uncached.txt
graphify-out/
**/graphify-out/

# Environment / secrets
.env
.env.local
*.local

# Test fixtures: regenerated at test time, never committed.
# (See tests/fixtures/README.md and apps/cli/tests/* for generators.)
tests/fixtures/*.wav
tests/fixtures/*.mp3
tests/fixtures/*.flac
tests/fixtures/*.ogg

# Demo screen captures: large binaries; tracked via Git LFS once Phase 1 ships.
assets/demos/*.mp4
assets/demos/*.mov
.vercel

# Output of a manual end-to-end run: screenshots of the built app, the
# WAV fixtures fed to it, and the write-up. Regenerated per session and
# several MB of PNGs, so it stays local — what a run *found* belongs in
# a commit message or an issue, not in a binary nobody diffs.
.e2e/
