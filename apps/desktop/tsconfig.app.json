{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* No implicit type libraries. App code runs in a webview, which has
       no Node; without an explicit list TypeScript included every
       installed @types package, `@types/node` among them, so `process`
       type-checked here and threw at runtime (#336). Tests are Node
       code and are checked by tsconfig.test.json. */
    "types": []
  },
  "include": ["src"],
  // Tests, by the same rule vitest uses to find them
  // (`src/**/*.{test,spec}.{ts,tsx}`) as well as by folder. Excluding by
  // folder alone would have let a test written beside its module land in
  // this program, without the Node types it runs with.
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
