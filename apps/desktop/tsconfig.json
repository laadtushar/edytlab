{
  // A solution file: no files of its own. Each file belongs to whichever
  // referenced project includes it, which is how an editor gives app
  // code, its tests and the Vite config each the types they really run
  // with (#336).
  //
  // Type-check with `pnpm typecheck` (`tsc -b`), which builds all three.
  // Plain `tsc --noEmit` against this file checks NOTHING and exits 0 —
  // verified with a type error in app code — because a solution file has
  // no inputs of its own.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
