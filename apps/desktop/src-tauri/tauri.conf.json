{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "edytlab",
  "version": "0.1.0",
  "identifier": "app.edytlab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "edytlab",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "resources": {
      "resources/templates/*": "templates/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Conversational audio editor",
    "longDescription": "edytlab is a desktop audio editor where you talk to Claude to do real audio editing — load, cut, gain, normalize, transcribe, and render WAVs by chatting.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "exceptionDomain": "api.anthropic.com"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
